# Clerk Authentication (required)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase (required for exercise library + cloud sync)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Cloud sync also needs: Clerk JWT template named "supabase" (aud: authenticated)
# and Supabase Auth configured to trust Clerk's JWKS. Run supabase/sync-schema.sql.

# ExerciseDB — optional, only needed for the one-time import script
# EXPO_PUBLIC_EXERCISEDB_API_KEY=your_rapidapi_key_here
# EXPO_PUBLIC_EXERCISEDB_API_HOST=exercisedb.p.rapidapi.com
